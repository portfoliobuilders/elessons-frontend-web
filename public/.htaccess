# G-TEC eLessons.net — Apache rules for GoDaddy cPanel (public_html)
# Production host: Linux/Apache. Do NOT add HSTS or CSP yet.

# 1. Custom 404
ErrorDocument 404 /404.html

# 2–4. HTTPS, non-www, /index.html → /
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Force non-www (canonical is https://elessons.net/)
  RewriteCond %{HTTP_HOST} ^www\.elessons\.net$ [NC]
  RewriteRule ^ https://elessons.net%{REQUEST_URI} [L,R=301]

  # /index.html → / (preserve query string)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

# 5. No directory listings
Options -Indexes

# 6. Gzip / DEFLATE
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 7. Cache-Control
<IfModule mod_headers.c>
  # Images / fonts — 1 year immutable
  <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # CSS / JS — 1 month
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML — no-cache
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # 8. Security headers (no HSTS, no CSP)
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# 9. MIME types
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>
